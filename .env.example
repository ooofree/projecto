# Project O environment configuration.
# Copy to .env and fill in the database credentials for a dedicated empty database.
APP_ENV=development
APP_DSN=mysql:host=127.0.0.1;port=3306;dbname=project_o;charset=utf8mb4
APP_DB_USER=project_o
APP_DB_PASSWORD=

# Field-level encryption key for sensitive person data (construction crew
# leader identity numbers, stored only as AES-256-GCM ciphertext plus an
# HMAC-SHA256 fingerprint). Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# It must be exactly 64 hex characters. Without it the crew directory still
# works, but saving an identity number fails with a clear message instead of
# dropping the value. Losing this key makes existing ciphertext unreadable.
APP_DATA_KEY=

# Image object storage (Cloudflare R2).
# Preferred: configure the bucket and credentials in the document module's
# system settings page (permission manage_document_settings); they are stored
# in the database.
# The APP_R2_* variables below remain as a deployment fallback that is used
# only when no database configuration has been saved. APP_OBJECT_STORAGE_ADAPTER
# may point to another ObjectStorageInterface implementation to override the
# built-in R2 adapter.
APP_R2_ACCOUNT_ID=
APP_R2_BUCKET=
APP_R2_ACCESS_KEY_ID=
APP_R2_SECRET_ACCESS_KEY=
APP_OBJECT_STORAGE_ADAPTER=

# Local cache for remotely stored images (document issue/RFI attachments and
# material sample photos). Caching avoids a multi-second remote round trip on
# every page view; it is read-through and degrades to a plain remote read when
# the directory is not writable.
# APP_IMAGE_CACHE_DIR defaults to <system temp>/project-o-image-cache. The
# directory must be writable by the PHP-FPM user (www-data in a stock Ubuntu
# install) and must NOT be reachable over HTTP: never point it at storage/ or
# anywhere else under the Apache DocumentRoot, or private images would become
# downloadable as plain static files without any permission check.
# APP_IMAGE_CACHE_TTL is the lifetime in seconds (default 604800 = 7 days; 0
# disables the cache). APP_IMAGE_CACHE_MAX_MB caps total disk usage (default
# 512); the oldest entries are evicted first.
APP_IMAGE_CACHE_DIR=
APP_IMAGE_CACHE_TTL=604800
APP_IMAGE_CACHE_MAX_MB=512

# Public base URL of the application, used to build the fixed crew-share links
# (e.g. https://pm.example.com/o/public/). Optional: the value is learned from
# the first web request and remembered in public/s/.base-url so that a later
# CLI publish (php bin/install.php) emits the same absolute links. Set it
# explicitly when the site sits behind a proxy or is reached under several
# hostnames and you want one canonical address in shared links.
APP_PUBLIC_URL=

# WeChat in-app share card (optional, off by default).
# WeChat only renders a custom title/description/thumbnail for
# "··· → 发送给朋友" when the page calls the JS-SDK after a successful wx.config.
# Per WeChat's official docs this requires a VERIFIED SERVICE ACCOUNT and a
# "JS接口安全域名" that is an ICP-filed domain — IP addresses and ports are not
# allowed, so localhost/LAN URLs can never show a card. Without these values the
# share page keeps its Open Graph metadata (used by link-preview crawlers) and
# the share dialog recommends "复制标题+链接" instead. The AppSecret is only ever
# used server-side to sign; it is never written into a page.
WECHAT_APPID=
WECHAT_APPSECRET=
