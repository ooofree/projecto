{
    "name": "project-o/project-manager",
    "description": "Lightweight, project-centered construction management platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "aws/aws-sdk-php": "^3.403"
    },
    "scripts": {
        "test": [
            "php tests/auth_service_test.php",
            "php tests/project_foundation_plugin_test.php",
            "php tests/project_service_test.php",
            "php tests/project_space_service_test.php",
            "php tests/document_management_test.php",
            "php tests/documents_home_smoke_test.php",
            "php tests/material_management_test.php",
            "php tests/platform_administration_test.php",
            "php tests/profile_service_test.php",
            "php tests/labor_crew_test.php",
            "php tests/bom_costing_test.php",
            "php tests/bom_costing_sql_placeholder_test.php",
            "php tests/bom_costing_web_smoke_test.php",
            "php tests/closeout_management_test.php",
            "php tests/closeout_locations_test.php",
            "php tests/closeout_management_web_smoke_test.php",
            "php tests/login_page_smoke_test.php",
            "php tests/projects_page_smoke_test.php",
            "php tests/layout_v21_smoke_test.php"
        ]
    },
    "autoload": {
        "psr-4": {
            "ProjectO\\": "src/",
            "ProjectO\\Modules\\ProjectFoundation\\": "modules/project-foundation/src/",
            "ProjectO\\Modules\\DocumentManagement\\": "modules/document-management/src/",
            "ProjectO\\Modules\\MaterialManagement\\": "modules/material-management/src/",
            "ProjectO\\Modules\\LaborCrew\\": "modules/labor-crew/src/",
            "ProjectO\\Modules\\BomCosting\\": "modules/bom-costing/src/",
            "ProjectO\\Modules\\CloseoutManagement\\": "modules/closeout-management/src/"
        }
    }
}
