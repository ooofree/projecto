:root {
    color-scheme: light;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #172033;
    background: #f3f6fb;
    font-synthesis: none;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; }
a { color: inherit; }
.topbar {
    height: 64px;
    padding: 0 max(24px, calc((100% - 1120px) / 2));
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fff;
    border-bottom: 1px solid #e4e9f1;
}
.brand { color: #214e9b; font-weight: 800; text-decoration: none; letter-spacing: .02em; }
.account, .account form { display: flex; align-items: center; gap: 14px; }
.container { width: min(1120px, calc(100% - 40px)); margin: 36px auto 72px; }
h1, h2, p { margin-top: 0; }
h1 { margin-bottom: 8px; font-size: clamp(1.7rem, 3vw, 2.2rem); }
h2 { margin-bottom: 0; font-size: 1.15rem; }
.muted { color: #68758a; }
.eyebrow { margin-bottom: 8px; color: #436bb0; font-size: .76rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
.page-heading { display: flex; justify-content: space-between; margin-bottom: 24px; }
.current-project, .panel, .auth-card {
    background: #fff;
    border: 1px solid #e4e9f1;
    border-radius: 14px;
    box-shadow: 0 8px 26px rgb(23 32 51 / 4%);
}
.current-project { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; margin-bottom: 20px; border-left: 4px solid #3569bd; }
.current-project h2 { font-size: 1.35rem; }
.current-project .eyebrow { margin-bottom: 5px; }
.panel { padding: 22px 24px; margin: 18px 0; }
.panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
.panel-heading .muted { margin: 6px 0 0; }
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; text-align: left; }
th, td { padding: 13px 10px; border-bottom: 1px solid #edf0f5; white-space: nowrap; }
th { color: #68758a; font-size: .78rem; font-weight: 650; }
tbody tr:last-child td { border-bottom: 0; }
.project-name { font-weight: 650; }
.badge, .selected-label { display: inline-flex; align-items: center; padding: 5px 10px; border-radius: 999px; background: #edf3fd; color: #315d9f; font-size: .78rem; font-weight: 650; }
.selected-label { background: #e8f7ef; color: #26734a; }
.actions form { margin: 0; }
.button { display: inline-flex; justify-content: center; align-items: center; min-height: 38px; padding: 8px 14px; border: 1px solid transparent; border-radius: 8px; font: inherit; font-size: .9rem; font-weight: 650; text-decoration: none; cursor: pointer; }
.button-primary { background: #285db4; color: #fff; }
.button-primary:hover { background: #204c96; }
.button-secondary { border-color: #d7dfeb; background: #fff; color: #254a82; }
.button-quiet { background: transparent; color: #54627a; }
.stack { display: grid; gap: 16px; }
.form-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
label { display: grid; gap: 7px; color: #3a465b; font-size: .88rem; font-weight: 650; }
input, select { width: 100%; min-height: 42px; padding: 9px 11px; border: 1px solid #cfd7e3; border-radius: 8px; background: #fff; color: #172033; font: inherit; }
textarea { width: 100%; min-height: 92px; padding: 9px 11px; border: 1px solid #cfd7e3; border-radius: 8px; background: #fff; color: #172033; font: inherit; resize: vertical; }
input:focus, select:focus { outline: 3px solid rgb(53 105 189 / 16%); border-color: #3569bd; }
textarea:focus { outline: 3px solid rgb(53 105 189 / 16%); border-color: #3569bd; }
.module-nav { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 18px; }
.record-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
.record-summary { margin: 0; }
.record-summary h2 { margin-bottom: 8px; }
.record-summary p { margin-bottom: 12px; }
.record-list { display: grid; gap: 14px; }
.record-card { padding: 18px; border: 1px solid #e4e9f1; border-radius: 12px; background: #fff; }
.record-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; }
.record-heading h3 { margin: 0; font-size: 1.02rem; line-height: 1.5; overflow-wrap: anywhere; }
.record-heading .eyebrow { margin-bottom: 5px; }
.record-badges { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 7px; }
.badge-neutral { background: #f0f2f6; color: #536176; }
.record-meta { margin: 10px 0; font-size: .84rem; line-height: 1.6; }
.record-tools { padding-top: 12px; margin-top: 12px; border-top: 1px solid #edf0f5; }
.record-tools > summary { color: #315d9f; font-weight: 650; cursor: pointer; }
.record-form { margin-top: 14px; }
.follow-up-list { display: grid; gap: 8px; padding-left: 20px; }
.follow-up-list li { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.follow-up-list form { margin: 0; }
.is-complete { color: #68758a; text-decoration: line-through; }
.inline-form { display: flex; align-items: flex-end; gap: 10px; margin-top: 12px; }
.inline-form label { flex: 1; }
.history-list { display: grid; gap: 12px; padding-left: 24px; }
.history-list li { padding-left: 4px; }
.history-list span { display: block; color: #68758a; font-size: .82rem; }
.history-list p { margin: 5px 0 0; overflow-wrap: anywhere; }
.checkbox-field { display: flex; grid-template-columns: auto 1fr; align-items: center; justify-content: flex-start; }
.checkbox-field input { width: 18px; min-height: 18px; margin: 0; }
.checkbox-group { display: flex; flex-wrap: wrap; gap: 10px 18px; padding: 14px; border: 1px solid #d7dfeb; border-radius: 8px; }
.checkbox-group legend { padding: 0 6px; color: #3a465b; font-size: .88rem; font-weight: 650; }
.admin-form { margin-bottom: 24px; }
.admin-record-list { display: grid; gap: 14px; margin-top: 20px; }
.admin-record { padding: 18px 0; border-top: 1px solid #edf0f5; }
.admin-record:first-of-type { border-top: 0; }
.runtime-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 0; }
.runtime-grid div { padding: 14px; border-radius: 9px; background: #f3f6fb; }
.runtime-grid dt { color: #68758a; font-size: .82rem; }
.runtime-grid dd { margin: 5px 0 0; font-weight: 650; overflow-wrap: anywhere; }
.field-wide { grid-column: 1 / -1; }
.auth-card { width: min(440px, 100%); margin: 8vh auto; padding: 30px; }
.auth-card .button { width: 100%; }
.empty-state { margin: 0; padding: 20px 0; color: #68758a; }
.notice { padding: 13px 16px; margin: 0 0 18px; border-radius: 9px; }
.notice-success { color: #216442; background: #e8f7ef; }
.notice-error { color: #963b36; background: #fff0ef; }
.notice-info { color: #315d9f; background: #edf3fd; margin: 0 0 20px; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
body.theme-dark { color: #e7edf7; background: #111827; }
body.theme-dark .topbar,
body.theme-dark .panel,
body.theme-dark .current-project,
body.theme-dark .auth-card,
body.theme-dark .record-card,
body.theme-dark .admin-record { background: #1b2535; border-color: #344156; }
body.theme-dark .current-project { border-left-color: #6d9ce8; }
body.theme-dark .brand,
body.theme-dark .module-nav a,
body.theme-dark .record-tools > summary { color: #a9c7ff; }
body.theme-dark .muted,
body.theme-dark th,
body.theme-dark .checkbox-group legend,
body.theme-dark label { color: #b7c3d6; }
body.theme-dark th,
body.theme-dark td,
body.theme-dark .admin-record { border-color: #344156; }
body.theme-dark input,
body.theme-dark select,
body.theme-dark textarea { color: #e7edf7; background: #111827; border-color: #526078; }
body.theme-dark input[readonly] { color: #b7c3d6; }
body.theme-dark .button-secondary { color: #d7e5ff; background: #25344b; border-color: #526078; }
body.theme-dark .button-quiet { color: #c4cfdf; }
body.theme-dark .badge { color: #c5d9ff; background: #293d5d; }
body.theme-dark .badge-neutral { color: #ccd4e0; background: #394354; }
body.theme-dark .selected-label { color: #a6e2bf; background: #1f4634; }
body.theme-dark .runtime-grid div { background: #25344b; }
body.theme-dark .runtime-grid dt { color: #b7c3d6; }
body.theme-dark .checkbox-group { border-color: #526078; }

:root {
    color: #202a35;
    background: #f2f3f1;
    font-family: "Aptos", "Segoe UI", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
}

body { background: #f2f3f1; }
.topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    height: 58px;
    padding-inline: max(32px, calc((100% - 1440px) / 2));
    background: rgb(250 250 248 / 96%);
    border-color: #dfe2de;
    backdrop-filter: blur(12px);
}
.brand {
    color: #243d3a;
    font-size: .92rem;
    letter-spacing: .12em;
    text-transform: uppercase;
}
.container { width: min(1440px, calc(100% - 64px)); margin-top: 38px; }
h1 { color: #202a35; font-size: clamp(1.8rem, 3vw, 2.45rem); font-weight: 650; letter-spacing: -.045em; }
h2 { color: #27343d; font-size: 1.08rem; font-weight: 680; letter-spacing: -.015em; }
.muted { color: #758078; }
.eyebrow { color: #57736a; font-size: .7rem; letter-spacing: .14em; }
.page-heading { align-items: flex-end; margin-bottom: 28px; }
.panel, .current-project, .auth-card {
    border-color: #dfe3dd;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgb(34 45 40 / 3%);
}
.panel { padding: 24px 28px; margin: 20px 0; }
.current-project { border-left: 3px solid #526f64; padding: 20px 24px; }
.record-card { border-color: #dfe3dd; border-radius: 4px; box-shadow: none; }
.button { min-height: 36px; border-radius: 4px; font-size: .85rem; font-weight: 620; }
.button-primary { background: #395c50; }
.button-primary:hover { background: #2e4b41; }
.button-secondary { border-color: #cfd7d0; color: #354e45; }
.button-secondary:hover { background: #f2f5f1; border-color: #aebdb2; }
.button-quiet { color: #647169; }
input, select, textarea { border-color: #d1d8d1; border-radius: 4px; }
input:focus, select:focus, textarea:focus { outline-color: rgb(69 109 92 / 17%); border-color: #638576; }
.badge, .selected-label { border-radius: 3px; background: #e8eee8; color: #3e6153; font-size: .74rem; }
.selected-label { background: #e5eee7; color: #3d6b4d; }
th {
    padding-block: 11px;
    background: #f4f5f2;
    color: #65716a;
    font-size: .7rem;
    font-weight: 720;
    letter-spacing: .07em;
    text-transform: uppercase;
}
td { padding-block: 12px; }
th, td { border-color: #e8ebe6; }
tbody tr:hover { background: #fafbf9; }
.report-intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; }
.report-kicker { color: #78827b; font-size: .78rem; letter-spacing: .03em; }
.report-heading { margin: 0; }
.report-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.report-strip {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 14px 0;
    margin: 0 0 20px;
    border-top: 1px solid #dfe3dd;
    border-bottom: 1px solid #dfe3dd;
}
.report-strip strong { color: #283a34; font-size: .92rem; font-weight: 670; }
.report-strip .divider { width: 1px; height: 22px; background: #dfe3dd; }
.report-strip .muted { font-size: .8rem; }
.report-table { min-width: 720px; }
.report-table th:first-child, .report-table td:first-child { padding-left: 14px; }
.report-table tbody tr { transition: background-color .15s ease; }
.report-table .material-primary { display: block; color: #263a33; font-weight: 660; }
.report-table .material-secondary { display: block; max-width: 560px; margin-top: 4px; color: #79837c; font-size: .8rem; font-weight: 400; white-space: normal; }
.report-code { color: #66766d; font-variant-numeric: tabular-nums; font-size: .82rem; }
.row-actions { display: flex; justify-content: flex-end; gap: 8px; }
.row-actions form { margin: 0; }
.row-editor { position: relative; }
.row-editor > summary { color: #49675a; font-size: .82rem; font-weight: 650; cursor: pointer; list-style: none; }
.row-editor > summary::-webkit-details-marker { display: none; }
.row-editor[open] > summary { margin-bottom: 12px; }
.row-editor .row-editor-form {
    position: absolute;
    right: 0;
    z-index: 10;
    width: min(620px, calc(100vw - 48px));
    padding: 20px;
    border: 1px solid #d7ded7;
    background: #fff;
    box-shadow: 0 12px 32px rgb(32 42 53 / 13%);
}
.toolbar {
    display: grid;
    grid-template-columns: minmax(240px, 1fr) minmax(180px, 260px) auto;
    align-items: end;
    gap: 12px;
    padding: 15px 0;
    border-top: 1px solid #e8ebe6;
}
.toolbar label { gap: 5px; font-size: .76rem; }
.toolbar input, .toolbar select { min-height: 38px; font-size: .86rem; }
.toolbar-count { align-self: center; justify-self: end; color: #758078; font-size: .78rem; white-space: nowrap; }
.disclosure {
    border: 1px solid #dfe3dd;
    border-radius: 4px;
    background: #fff;
}
.disclosure > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    color: #354c42;
    font-size: .88rem;
    font-weight: 650;
    cursor: pointer;
    list-style: none;
}
.disclosure > summary::-webkit-details-marker { display: none; }
.disclosure > summary::after { content: "+"; color: #6b8176; font-size: 1.15rem; font-weight: 400; }
.disclosure[open] > summary::after { content: "−"; }
.disclosure-content { padding: 0 20px 20px; border-top: 1px solid #e8ebe6; }
.category-table { min-width: 580px; }
.category-table .category-name { color: #2d4037; font-weight: 640; }
.inline-editor {
    display: grid;
    grid-template-columns: minmax(150px, 1fr) minmax(150px, 1fr) 110px auto;
    align-items: end;
    gap: 10px;
    padding: 12px 0;
    border-bottom: 1px solid #edf0ec;
}
.inline-editor:last-child { border-bottom: 0; }
.inline-editor label { gap: 4px; font-size: .75rem; }
.inline-editor input, .inline-editor select { min-height: 36px; font-size: .83rem; }
.report-empty { padding: 30px 12px; color: #758078; text-align: center; }
.project-table { min-width: 680px; }
.project-current-row { background: #f5f7f3; }
.project-current-row td:first-child { box-shadow: inset 3px 0 #668174; }
.project-create { margin-top: 16px; }
.project-create .form-grid { padding-top: 18px; border-top: 1px solid #e8ebe6; }
.project-quick-links { display: flex; flex-wrap: wrap; gap: 8px; margin-left: auto; }
.current-project { display: flex; align-items: center; gap: 16px; }
.current-project > div:first-child { min-width: 180px; }
.current-project h2 { margin: 0; font-size: 1.18rem; }
.current-project .button { white-space: nowrap; }
body.theme-dark { color: #e6ebe7; background: #131a18; }
body.theme-dark .topbar { background: rgb(25 34 31 / 96%); border-color: #35413b; }
body.theme-dark .brand, body.theme-dark h1, body.theme-dark h2 { color: #e0e9e2; }
body.theme-dark .panel, body.theme-dark .current-project, body.theme-dark .disclosure,
body.theme-dark .row-editor .row-editor-form { background: #1b2521; border-color: #35413b; }
body.theme-dark .report-strip, body.theme-dark .report-strip .divider { border-color: #35413b; }
body.theme-dark .report-strip .divider { background: #35413b; }
body.theme-dark .report-strip strong, body.theme-dark .report-table .material-primary,
body.theme-dark .category-table .category-name { color: #dce8df; }
body.theme-dark th { color: #b1beb5; background: #222e28; }
body.theme-dark td, body.theme-dark th, body.theme-dark .inline-editor,
body.theme-dark .disclosure-content, body.theme-dark .project-create .form-grid { border-color: #35413b; }
body.theme-dark tbody tr:hover, body.theme-dark .project-current-row { background: #202c26; }
body.theme-dark .row-editor .row-editor-form { background: #1b2521; }
body.theme-dark .report-code, body.theme-dark .report-table .material-secondary { color: #aab9ae; }
body.theme-dark .report-strip strong, body.theme-dark .disclosure > summary,
body.theme-dark .row-editor > summary { color: #c2d7c8; }
body.theme-dark .button-primary { color: #fff; background: #527967; }
body.theme-dark .button-secondary { color: #d7e5db; background: #25342b; border-color: #4a5b50; }
.edit-dialog {
    width: min(760px, calc(100% - 32px));
    max-height: min(86vh, 900px);
    padding: 26px;
    border: 1px solid #dfe3dd;
    border-radius: 6px;
    color: #202a35;
    background: #fbfcfa;
    box-shadow: 0 24px 80px rgb(22 33 28 / 24%);
}
.edit-dialog::backdrop { background: rgb(26 36 31 / 48%); backdrop-filter: blur(2px); }
.dialog-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
.dialog-heading h2 { margin: 0; font-size: 1.25rem; }
.dialog-actions { display: flex; justify-content: flex-end; }
.category-editor > summary { color: #49675a; font-size: .82rem; font-weight: 650; cursor: pointer; list-style: none; }
.category-editor > summary::-webkit-details-marker { display: none; }
.category-editor[open] { position: absolute; z-index: 8; right: 12px; width: min(620px, calc(100vw - 48px)); padding: 16px; border: 1px solid #d7ded7; background: #fff; box-shadow: 0 12px 32px rgb(32 42 53 / 13%); }
.category-editor .inline-editor { grid-template-columns: 1fr 1fr 100px auto; }
body.theme-dark .edit-dialog { color: #e6ebe7; background: #1b2521; border-color: #35413b; }
body.theme-dark .category-editor[open] { background: #1b2521; border-color: #35413b; }
@media (max-width: 800px) {
    .container { width: min(100% - 32px, 1440px); margin-top: 26px; }
    .topbar { padding-inline: 16px; }
    .report-intro { align-items: flex-start; flex-direction: column; }
    .toolbar { grid-template-columns: 1fr 1fr; }
    .toolbar label:first-child { grid-column: 1 / -1; }
    .toolbar-count { grid-column: 1 / -1; justify-self: start; }
    .current-project { align-items: flex-start; flex-wrap: wrap; }
    .project-quick-links { margin-left: 0; }
    .category-editor .inline-editor { grid-template-columns: 1fr; }
}
@media (max-width: 540px) {
    .container { width: calc(100% - 24px); margin-top: 20px; }
    .panel { padding: 18px 14px; }
    .toolbar { grid-template-columns: 1fr; }
    .toolbar label:first-child, .toolbar-count { grid-column: auto; }
    .report-strip { align-items: flex-start; flex-direction: column; gap: 5px; }
    .report-strip .divider { display: none; }
    .inline-editor { grid-template-columns: 1fr; }
    .row-editor .row-editor-form { right: -8px; }
    .edit-dialog { padding: 18px; }
}
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
}
@media (max-width: 700px) {
    .form-grid { grid-template-columns: 1fr; }
    .field-wide { grid-column: auto; }
    .panel { padding: 18px 14px; }
    .record-grid { grid-template-columns: 1fr; }
    .record-heading { flex-direction: column; }
    .record-badges { justify-content: flex-start; }
    .inline-form { align-items: stretch; flex-direction: column; }
    .checkbox-field { grid-column: 1 / -1; }
    .runtime-grid { grid-template-columns: 1fr; }
    .topbar { padding: 0 18px; }
    .container { width: min(100% - 28px, 1120px); margin-top: 24px; }
}

.container { width: min(1680px, calc(100% - 64px)); margin-top: 28px; }
.page-heading { margin-bottom: 18px; }
.page-heading .eyebrow { margin-bottom: 4px; }
.page-heading h1 { margin-bottom: 0; }
.panel { padding: 18px 22px; }
.panel-heading { margin-bottom: 12px; }
.project-table { width: 100%; min-width: 0; table-layout: fixed; }
.project-table th:nth-child(1), .project-table td:nth-child(1) { width: 38%; }
.project-table th:nth-child(2), .project-table td:nth-child(2) { width: 14%; }
.project-table th:nth-child(3), .project-table td:nth-child(3),
.project-table th:nth-child(4), .project-table td:nth-child(4) { width: 18%; }
.project-table th:nth-child(5), .project-table td:nth-child(5) { width: 12%; }
.project-table th.actions, .project-table td.actions { text-align: right; }
.project-table td:first-child { overflow: hidden; text-overflow: ellipsis; }
.project-list-actions { display: flex; align-items: center; gap: 14px; }
.project-create { position: relative; margin: 0; }
.project-list-actions { position: relative; }
.project-create > summary { list-style: none; cursor: pointer; }
.project-create > summary::-webkit-details-marker { display: none; }
.project-create[open] .project-create-form {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 15;
    width: min(680px, calc(100vw - 48px));
    padding: 20px;
    border: 1px solid #dfe3dd;
    background: #fbfcfa;
    box-shadow: 0 14px 36px rgb(34 45 40 / 14%);
}
.current-project {
    justify-content: flex-start;
    min-height: 48px;
    padding: 7px 0 13px;
    margin: 0 0 8px;
    border: 0;
    border-bottom: 1px solid #dfe3dd;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
}
.current-project > strong { color: #293630; font-size: .94rem; font-weight: 650; }
.current-project .badge { margin-left: 2px; }
.current-project .project-quick-links .button { min-height: 30px; padding: 5px 9px; }
.project-quick-links { gap: 6px; }
.report-table { width: 100%; min-width: 0; table-layout: fixed; }
.report-table th:nth-child(1), .report-table td:nth-child(1) { width: 14%; }
.report-table th:nth-child(2), .report-table td:nth-child(2) { width: 40%; }
.report-table th:nth-child(3), .report-table td:nth-child(3) { width: 19%; }
.report-table th:nth-child(4), .report-table td:nth-child(4) { width: 10%; }
.report-table th:nth-child(5), .report-table td:nth-child(5) { width: 17%; }
.report-table th:last-child, .report-table td:last-child { text-align: right; }
.material-mobile-meta { display: none; }
.report-strip { display: none; }
.toolbar { padding: 11px 0; }
.toolbar input, .toolbar select { min-height: 36px; }
.disclosure { border-color: #e2e5e0; }
.disclosure > summary { padding: 13px 16px; }
.category-table { width: 100%; min-width: 0; }
.category-editor[open] { position: relative; right: auto; width: min(680px, calc(100vw - 64px)); }
body { min-height: 100vh; }

body.theme-dark {
    min-height: 100vh;
    color-scheme: dark;
    color: #e2e5e3;
    background: #171a1c;
}
body.theme-dark .topbar { background: rgb(30 34 36 / 97%); border-color: #383d3f; }
body.theme-dark .brand, body.theme-dark h1, body.theme-dark h2 { color: #e5e8e6; }
body.theme-dark .muted, body.theme-dark .toolbar-count { color: #a7aeab; }
body.theme-dark .panel,
body.theme-dark .auth-card,
body.theme-dark .record-card,
body.theme-dark .disclosure,
body.theme-dark .edit-dialog,
body.theme-dark .project-create[open] .project-create-form,
body.theme-dark .category-editor[open],
body.theme-dark .row-editor .row-editor-form {
    color: #e2e5e3;
    background: #222628;
    border-color: #3a4042;
    box-shadow: none;
}
body.theme-dark .current-project {
    color: #e2e5e3;
    background: transparent;
    border: 0;
    border-bottom: 1px solid #3a4042;
    box-shadow: none;
}
body.theme-dark .current-project > strong,
body.theme-dark .report-table .material-primary,
body.theme-dark .category-table .category-name { color: #e2e7e3; }
body.theme-dark th { color: #b7bfbb; background: #292e30; }
body.theme-dark th, body.theme-dark td,
body.theme-dark .inline-editor,
body.theme-dark .disclosure-content,
body.theme-dark .project-create .form-grid { border-color: #3a4042; }
body.theme-dark tbody tr:hover,
body.theme-dark .project-current-row { background: #292f31; }
body.theme-dark .project-current-row td:first-child { box-shadow: inset 3px 0 #82968b; }
body.theme-dark .report-code,
body.theme-dark .report-table .material-secondary { color: #adb6b1; }
body.theme-dark .badge,
body.theme-dark .badge-neutral {
    color: #d3d9d5;
    background: #343a3c;
}
body.theme-dark .selected-label { color: #d0dbd2; background: #303b34; }
body.theme-dark .button-primary { color: #f5f6f5; background: #52665b; }
body.theme-dark .button-primary:hover { background: #607568; }
body.theme-dark .button-secondary {
    color: #d7ddda;
    background: #2a3032;
    border-color: #4a5153;
}
body.theme-dark .button-secondary:hover { background: #343b3d; border-color: #697270; }
body.theme-dark .button-quiet { color: #c1c8c4; }
body.theme-dark label { color: #c5ccc8; }
body.theme-dark input,
body.theme-dark select,
body.theme-dark textarea {
    color: #e3e7e4;
    background: #191d1f;
    border-color: #4a5153;
}
body.theme-dark input::placeholder,
body.theme-dark textarea::placeholder { color: #929b96; }
body.theme-dark input:focus,
body.theme-dark select:focus,
body.theme-dark textarea:focus { border-color: #8b9b91; outline-color: rgb(139 155 145 / 20%); }
body.theme-dark .notice-info,
body.theme-dark .notice-success,
body.theme-dark .notice-error {
    color: #d4d9d6;
    background: #292f31;
    border: 1px solid #3a4042;
}
body.theme-dark .runtime-grid div { background: #292f31; }
body.theme-dark .runtime-grid dt,
body.theme-dark .empty-state,
body.theme-dark .report-empty { color: #a7aeab; }
body.theme-dark .checkbox-group { border-color: #4a5153; }
body.theme-dark .checkbox-group legend { color: #c5ccc8; }
body.theme-dark .is-complete { color: #a7aeab; }
body.theme-dark .edit-dialog::backdrop { background: rgb(0 0 0 / 68%); }

@media (max-width: 800px) {
    .container { width: calc(100% - 40px); margin-top: 24px; }
    .topbar { padding-inline: 20px; }
    .current-project { align-items: center; flex-wrap: wrap; }
}
@media (max-width: 700px) {
    .container { width: calc(100% - 32px); }
    .project-table th:nth-child(3), .project-table td:nth-child(3),
    .project-table th:nth-child(4), .project-table td:nth-child(4) { display: none; }
    .project-table th:nth-child(1), .project-table td:nth-child(1) { width: 55%; }
    .project-table th:nth-child(2), .project-table td:nth-child(2) { width: 22%; }
    .project-table th:nth-child(5), .project-table td:nth-child(5) { width: 23%; }
    .project-table th, .project-table td { padding-inline: 6px; }
    .project-table td.actions .button { min-height: 34px; padding: 5px 6px; font-size: .76rem; }
    .project-list-actions { gap: 8px; }
    .current-project { gap: 8px 12px; }
    .current-project .project-quick-links { flex-basis: 100%; }
}
@media (max-width: 540px) {
    .container { width: calc(100% - 24px); margin-top: 20px; }
    .panel { padding: 15px 12px; }
    .project-list-actions { gap: 5px; }
    .project-create[open] .project-create-form { right: -4px; width: calc(100vw - 32px); }
    .current-project .project-quick-links .button { min-height: 28px; }
}

html { min-height: 100%; background: #f2f3f1; }
html:has(body.theme-dark) { background: #202321; }
body { min-height: 100vh; }

.container {
    width: min(1720px, calc(100% - 72px));
    margin: 26px auto 64px;
}
.page-heading { margin-bottom: 16px; }
.page-heading h1 { margin-bottom: 2px; font-size: clamp(1.65rem, 2.2vw, 2rem); }
.page-heading .muted { margin: 4px 0 0; font-size: .88rem; line-height: 1.5; }
.eyebrow { margin-bottom: 4px; }
.module-nav {
    flex-wrap: nowrap;
    gap: 4px;
    overflow-x: auto;
    padding: 2px 0 8px;
    margin-bottom: 14px;
    scrollbar-width: thin;
    scrollbar-color: #c9ceca transparent;
}
.module-nav .button { flex: 0 0 auto; min-height: 34px; padding: 6px 11px; }
.panel {
    padding: 18px 22px;
    margin: 14px 0;
    border-radius: 3px;
    box-shadow: 0 1px 3px rgb(34 45 40 / 4%);
}
.panel-heading { margin-bottom: 12px; }
.panel-heading p { max-width: 80ch; font-size: .83rem; line-height: 1.5; }
.record-card { padding: 14px 16px; border-radius: 3px; }
.record-list { gap: 8px; }
.record-tools { margin-top: 9px; padding-top: 9px; }
.table-wrap { width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; }
table { width: 100%; }
th, td { padding: 10px 9px; }
.form-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.form-grid label { min-width: 0; }
.form-grid input, .form-grid select, .form-grid textarea { min-width: 0; }
form.form-grid:not(.record-form) { row-gap: 12px; }
form.form-grid:not(.record-form) > .field-wide:has(button) { margin-top: 1px; }
label { gap: 5px; font-size: .82rem; }
input, select { min-height: 38px; padding: 7px 10px; }
textarea { min-height: 78px; padding: 8px 10px; }
.button { min-height: 34px; padding: 6px 11px; font-size: .82rem; }
.button-primary { background: #49675a; }
.button-primary:hover { background: #3c574a; }
.button-secondary { background: transparent; }
.notice { border-radius: 3px; }
.notice-info { margin-bottom: 14px; }
.badge, .selected-label { padding: 4px 8px; }
.admin-record { padding: 14px 0; }
.admin-record-list { gap: 8px; }
.checkbox-group { border-radius: 3px; }
.runtime-grid div { border-radius: 3px; }
.entry-disclosure {
    margin: 0 0 12px;
    border-bottom: 1px solid #e8ebe6;
}
.entry-disclosure > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 36px;
    padding: 5px 0;
    color: #647169;
    font-size: .82rem;
    font-weight: 620;
    cursor: pointer;
    list-style: none;
}
.entry-disclosure > summary::-webkit-details-marker { display: none; }
.entry-disclosure > summary::after { content: "+"; color: #7d8981; font-size: 1rem; }
.entry-disclosure[open] > summary::after { content: "−"; }
.entry-disclosure > .form-grid { padding: 10px 0 16px; }
body.theme-dark .entry-disclosure { border-color: #414743; }
body.theme-dark .entry-disclosure > summary { color: #c1cac4; }

body.theme-dark {
    color-scheme: dark;
    color: #e6e9e6;
    background: #202321;
}
body.theme-dark .topbar {
    color: #e6e9e6;
    background: rgb(39 43 40 / 97%);
    border-color: #414743;
}
body.theme-dark .brand,
body.theme-dark h1,
body.theme-dark h2,
body.theme-dark h3,
body.theme-dark h4,
body.theme-dark strong { color: #e6e9e6; }
body.theme-dark .muted,
body.theme-dark .record-meta,
body.theme-dark .history-list span { color: #adb5b0; }
body.theme-dark .panel,
body.theme-dark .auth-card,
body.theme-dark .record-card,
body.theme-dark .admin-record,
body.theme-dark .disclosure,
body.theme-dark .edit-dialog,
body.theme-dark .project-create[open] .project-create-form,
body.theme-dark .category-editor[open],
body.theme-dark .row-editor .row-editor-form {
    color: #e6e9e6;
    background-color: #2a2e2b;
    border-color: #414743;
    box-shadow: none;
}
body.theme-dark .current-project {
    color: #e6e9e6;
    background: transparent;
    border-color: #414743;
    box-shadow: none;
}
body.theme-dark .module-nav .button-secondary,
body.theme-dark .button-secondary {
    color: #d7ddd8;
    background: #303532;
    border-color: #4a514c;
}
body.theme-dark .module-nav .button-secondary:hover,
body.theme-dark .button-secondary:hover { background: #3a403c; }
body.theme-dark .button-primary { color: #f2f4f2; background: #617468; }
body.theme-dark .button-primary:hover { background: #708579; }
body.theme-dark .button-quiet { color: #c5ccc7; }
body.theme-dark .module-nav { scrollbar-color: #535b55 transparent; }
body.theme-dark th { color: #c2c9c4; background: #333835; }
body.theme-dark th,
body.theme-dark td,
body.theme-dark .admin-record,
body.theme-dark .record-tools,
body.theme-dark .history-list,
body.theme-dark .checkbox-group,
body.theme-dark .record-tools,
body.theme-dark .runtime-grid div { border-color: #414743; }
body.theme-dark tbody tr:hover,
body.theme-dark .project-current-row { background: #343a36; }
body.theme-dark .project-current-row td:first-child { box-shadow: inset 3px 0 #91a095; }
body.theme-dark input,
body.theme-dark select,
body.theme-dark textarea {
    color: #e6e9e6;
    background-color: #242825;
    border-color: #505852;
    color-scheme: dark;
}
body.theme-dark input::placeholder,
body.theme-dark textarea::placeholder { color: #a0a9a3; }
body.theme-dark input:focus,
body.theme-dark select:focus,
body.theme-dark textarea:focus { border-color: #97a69b; outline-color: rgb(151 166 155 / 22%); }
body.theme-dark input:disabled,
body.theme-dark select:disabled,
body.theme-dark textarea:disabled { color: #aab2ad; background-color: #2c312d; }
body.theme-dark .badge,
body.theme-dark .badge-neutral,
body.theme-dark .selected-label { color: #d7ddd8; background: #3a403c; }
body.theme-dark .notice-info,
body.theme-dark .notice-success,
body.theme-dark .notice-error {
    color: #dce1dd;
    background: #303633;
    border: 1px solid #444c46;
}
body.theme-dark .runtime-grid div { background: #303633; }
body.theme-dark .runtime-grid dt,
body.theme-dark .empty-state,
body.theme-dark .report-empty,
body.theme-dark .history-list span { color: #adb5b0; }
body.theme-dark .record-tools > summary,
body.theme-dark .category-editor > summary,
body.theme-dark .row-editor > summary,
body.theme-dark .disclosure > summary { color: #c7d1ca; }
body.theme-dark .report-code,
body.theme-dark .report-table .material-secondary,
body.theme-dark .material-mobile-meta { color: #b7c0ba; }
body.theme-dark .edit-dialog::backdrop { background: rgb(0 0 0 / 62%); }

@media (max-width: 900px) {
    .container { width: calc(100% - 40px); }
    .form-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .field-wide { grid-column: 1 / -1; }
}
@media (max-width: 560px) {
    .container { width: calc(100% - 24px); margin-top: 18px; }
    .topbar { height: 54px; padding-inline: 12px; }
    .account, .account form { gap: 7px; }
    .account { font-size: .82rem; }
    .account .button { min-height: 31px; padding: 5px 7px; }
    .module-nav { margin-inline: -2px; }
    .module-nav .button { min-height: 32px; padding: 5px 9px; font-size: .78rem; }
    .page-heading { margin-bottom: 12px; }
    .panel { padding: 14px 12px; margin: 10px 0; }
    .panel-heading { align-items: flex-start; gap: 8px; }
    .form-grid { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .field-wide { grid-column: auto; }
    .table-wrap { margin-inline: -2px; width: calc(100% + 4px); }
    .record-heading { flex-direction: column; }
    .record-badges { justify-content: flex-start; }
    .inline-form { align-items: stretch; flex-direction: column; }
    .entry-disclosure > .form-grid { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 640px) {
    .report-table th:nth-child(1), .report-table td:nth-child(1),
    .report-table th:nth-child(3), .report-table td:nth-child(3) { display: none; }
    .report-table th:nth-child(2), .report-table td:nth-child(2) { width: 64%; }
    .report-table th:nth-child(4), .report-table td:nth-child(4) { width: 12%; }
    .report-table th:nth-child(5), .report-table td:nth-child(5) { width: 24%; }
    .report-table th, .report-table td { padding-inline: 6px; }
    .material-mobile-meta { display: block; margin-top: 3px; color: #78827b; font-size: .74rem; }
    .row-actions { justify-content: flex-end; gap: 2px; }
    .row-actions .button { min-height: 32px; padding: 4px; font-size: .72rem; }
    body.theme-dark .material-mobile-meta { color: #adb6b1; }
}
